# ── Environment ───────────────────────────────────────────────
AXIOM_ENV=development

# ── Server ────────────────────────────────────────────────────
AXIOM_BIND=0.0.0.0:4000
AXIOM_WORKERS=1
AXIOM_TIMEOUT=120
AXIOM_GRACEFUL_TIMEOUT=30
AXIOM_KEEPALIVE=5
AXIOM_LOG_LEVEL=debug

# ── Gunicorn ──────────────────────────────────────────────────
AXIOM_MAX_REQUESTS=0
AXIOM_MAX_REQUESTS_JITTER=0

# ── Proxy ─────────────────────────────────────────────────────
AXIOM_FORWARDED_ALLOW_IPS=*
AXIOM_PROXY_ALLOW_FROM=*
